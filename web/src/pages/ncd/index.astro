---
import Base from "../../layouts/Base.astro";
import Ncd from "../../components/ncd/Ncd.svelte";
---
<Base title="คัดกรอง NCDs" current="ncd" description="Multi-omics risk: NMR + cfDNA + EHR/HIS → ความเสี่ยงเบาหวาน หัวใจ ไขมันพอกตับ ไต และกลุ่มอาการเมตาบอลิก พร้อมเหตุผลและแผนดูแล">
  <div class="container page">
    <h1 class="t">คัดกรองความเสี่ยงโรค NCDs</h1>
    <p class="sub">รวม NMR, cfDNA และข้อมูลจากระบบโรงพยาบาล → ความเสี่ยง 5 โรค พร้อมเหตุผลที่ตรวจสอบได้ และแผนดูแลที่แพทย์อนุมัติ</p>
    <Ncd client:load />
  </div>
</Base>
<style>.t { margin-bottom: 8px; } .sub { color: var(--ink-2); max-width: 64ch; margin-bottom: 24px; }</style>
