---
import MainLayout from "../layouts/MainLayout.astro";
import OmicsHero from "../components/OmicsHero.astro";
---
<MainLayout title="Multi-omics" current="home">
  <section class="flex min-h-[70vh] flex-col items-center justify-center text-center" aria-labelledby="h-hero">
    <div class="w-full max-w-3xl"><OmicsHero /></div>
    <h1 id="h-hero" class="-mt-4 text-5xl sm:text-7xl font-semibold tracking-tight">Multi-omics</h1>
    <p class="mt-3 text-lg text-ink-2">Metabolomics · cfDNA</p>
    <p class="mt-6 text-sm text-ink-3"><span class="hidden md:inline">เลือกดูผลจากแถบเมนูด้านบน</span><span class="md:hidden">เลือกดูผลจากแถบเมนูด้านล่าง</span></p>
  </section>
</MainLayout>
