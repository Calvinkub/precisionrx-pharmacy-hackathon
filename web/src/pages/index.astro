---
import MainLayout from "../layouts/MainLayout.astro";
import StatusChip from "../components/StatusChip.astro";
import Sources from "../components/Sources.astro";
import SourceBadge from "../components/SourceBadge.astro";
import DataSources from "../components/DataSources.astro";
import mock from "../data/mockPatient.json";
import c from "../data/computed.json";
import { Cigarette, HeartPulse, Pill, Ruler, Scale, Users, Wine, Target } from "@lucide/astro";

const p = mock.profile;
// thresholds: Thai obesity (BMI ≥25, waist ≥90 M / ≥80 F) · Thai HT 2024 (<120/80 optimal, 130–139/85–89 high-normal, ≥140/90 high)
const bmiTone = c.bmi >= 25 ? "bad" : c.bmi >= 23 ? "warn" : "good";
const bmiLabel = c.bmi >= 25 ? "อ้วน (เกณฑ์เอเชีย)" : c.bmi >= 23 ? "น้ำหนักเกิน" : "ปกติ";
const waistCut = p.sex === "male" ? 90 : 80;
const bpTone = p.sbp >= 140 || p.dbp >= 90 ? "bad" : p.sbp >= 130 || p.dbp >= 85 ? "warn" : "good";
const bpLabel = bpTone === "bad" ? "สูง" : bpTone === "warn" ? "สูงกว่าปกติ" : "ปกติ";
const cards = [
  { icon: Ruler, label: "ส่วนสูง", value: p.height_cm, unit: "ซม.", tone: "neutral", chip: "—" },
  { icon: Scale, label: "น้ำหนัก", value: p.weight_kg, unit: "กก.", tone: "neutral", chip: "—" },
  { icon: Scale, label: "BMI", value: c.bmi, unit: "kg/m²", tone: bmiTone, chip: bmiLabel, sub: "ปกติ 18.5–22.9" },
  { icon: Target, label: "รอบเอว", value: p.waist_cm, unit: "ซม.", tone: p.waist_cm >= waistCut ? "warn" : "good", chip: p.waist_cm >= waistCut ? "เกินเกณฑ์" : "ปกติ", sub: `เกณฑ์ < ${waistCut}` },
  { icon: HeartPulse, label: "ความดันโลหิต", value: `${p.sbp}/${p.dbp}`, unit: "mmHg", tone: bpTone, chip: bpLabel, sub: "ปกติ < 130/85" },
] as const;
---
<MainLayout title="ข้อมูลพื้นฐาน" current="baseline">
  <p class="eyebrow">ข้อมูลพื้นฐาน · ตัวอย่าง</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">{p.name}</h1>
  <p class="mt-1 flex items-center gap-2 text-ink-2">{p.age} ปี · {p.sex === "male" ? "ชาย" : "หญิง"} <SourceBadge no={1} /></p>

  <div class="mt-8"><DataSources /></div>

  <section aria-label="สัญญาณชีพ" class="mt-4 grid grid-cols-2 lg:grid-cols-5 gap-3">
    {cards.map((k) => (
      <article class="card flex flex-col gap-2">
        <div class="flex items-center justify-between text-ink-3"><span class="flex items-center gap-1.5 text-sm"><SourceBadge no={2} />{k.label}</span><k.icon size={18} aria-hidden="true" /></div>
        <p class="num text-3xl font-medium tracking-tight">{k.value}<span class="ml-1 text-sm text-ink-3 font-normal">{k.unit}</span></p>
        {k.tone !== "neutral" && <div><StatusChip tone={k.tone} label={k.chip} /></div>}
        {"sub" in k && <p class="text-xs text-ink-3">{k.sub}</p>}
      </article>
    ))}
  </section>
  <p class="mt-3 text-xs text-ink-3">เกณฑ์ BMI และรอบเอวของคนไทย · ความดันตามแนวทางสมาคมความดันโลหิตสูงแห่งประเทศไทย 2024 · <Sources ids={["THAI-OBESITY", "THAI-HT-2024-NA"]} /></p>

  <section aria-labelledby="h-life" class="mt-8 grid gap-3 md:grid-cols-2">
    <article class="card">
      <h2 id="h-life" class="eyebrow flex items-center gap-1.5"><SourceBadge no={1} />ไลฟ์สไตล์</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        <li class="inline-flex items-center gap-2 rounded-full bg-subtle px-3 py-1.5 text-sm"><Cigarette size={16} aria-hidden="true" />{p.smoking === "ex-smoker" ? "เคยสูบบุหรี่ (เลิกแล้ว)" : p.smoking === "current" ? "สูบบุหรี่" : "ไม่สูบบุหรี่"}</li>
        <li class="inline-flex items-center gap-2 rounded-full bg-subtle px-3 py-1.5 text-sm"><Wine size={16} aria-hidden="true" />แอลกอฮอล์ {p.alcohol}</li>
        <li class="inline-flex items-center gap-2 rounded-full bg-subtle px-3 py-1.5 text-sm"><Pill size={16} aria-hidden="true" />{p.medications.length ? p.medications.join(", ") : "ไม่มียาประจำ"}</li>
        <li class="inline-flex items-center gap-2 rounded-full bg-subtle px-3 py-1.5 text-sm"><HeartPulse size={16} aria-hidden="true" />ออกกำลังกาย {p.activity_min_week} นาที/สัปดาห์</li>
      </ul>
    </article>
    <article class="card">
      <h2 class="eyebrow flex items-center gap-1.5"><SourceBadge no={1} />ประวัติครอบครัว</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {p.family_history.map((f) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-warn-soft px-3 py-1.5 text-sm"><Users size={16} aria-hidden="true" />{f.relation} · {f.condition}</li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-ink-2">→ คะแนนเสี่ยงเบาหวาน +4</p>
    </article>
  </section>

  <a href="/overview/" class="btn btn-primary mt-8 no-underline">ดูภาพรวมความเสี่ยง →</a>
</MainLayout>
