---
import Base from "../layouts/Base.astro";
import EvalStats from "../components/EvalStats.svelte";

const steps = [
  ["ผลตรวจ NMR", "รับค่าที่แล็บคำนวณแล้ว สรุปเป็น 6 เรื่องสุขภาพที่อ่านเข้าใจได้ทันที"],
  ["ยาที่กินประจำ", "ดึงจากประวัติรับยา รู้ว่ายาตัวไหนเปลี่ยนค่าในเลือด จะได้ไม่อ่านความเสี่ยงผิด"],
  ["ความเสี่ยงและเรื่องยา", "ใช้คะแนนความเสี่ยงของคนไทย และกฎจาก guideline ที่ตรวจสอบได้"],
  ["ติดตามผล", "ตรวจครั้งใหม่ บอกได้ว่าดีขึ้นจริง หรือแค่แกว่งตามธรรมชาติ"],
];
const links = [
  ["/dashboard/?case=1&visit=2", "ผลตรวจ", "ผล NMR และเรื่องยาสำหรับเภสัชกร"],
  ["/medications/?case=1&visit=2", "ยาที่ใช้ประจำ", "ยาแต่ละตัวเปลี่ยนค่าในเลือดอย่างไร"],
  ["/care/?case=1&visit=2", "ความเสี่ยงและการดูแลตัวเอง", "สรุปสำหรับคุยกับผู้ป่วย พิมพ์ได้"],
  ["/cfdna/", "cfDNA มะเร็ง", "ผล ctDNA + ยีนของผู้ป่วย + ยาตีกัน ในรายงานเดียว"],
];
---
<Base title="ภาพรวม" current="home">
  <div class="container">
    <section class="hero">
      <p class="eyebrow">ต้นแบบสำหรับ pharmacy hackathon</p>
      <h1>ผลตรวจที่คนไข้มีอยู่แล้ว<br />ควรถูกใช้ทุกครั้งที่สั่งยา</h1>
      <p class="lead">PrecisionRx รวมผล NMR ผลตรวจยีน และยาที่ใช้ เป็นข้อเสนอสั้น ๆ ที่เภสัชกรตัดสินใจได้ ทุกข้อความมีแหล่งอ้างอิง และเตือนเฉพาะเรื่องที่ต้องทำ</p>
      <div class="cta">
        <a class="btn btn-primary" href="/dashboard/?case=1&visit=2">ดูตัวอย่าง</a>
        <a class="btn" href="/care/?case=1&visit=2">ดูสรุปสำหรับผู้ป่วย</a>
      </div>
    </section>

    <section class="block" aria-labelledby="h-eval">
      <h2 id="h-eval">ผลชุดทดสอบ</h2>
      <div class="gap"></div>
      <EvalStats client:load />
    </section>

    <section class="block" aria-labelledby="h-how">
      <h2 id="h-how">ทำงานอย่างไร</h2>
      <ol class="steps">
        {steps.map(([t, d], i) => (
          <li><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="h-try">
      <h2 id="h-try">ลองใช้งาน</h2>
      <ul class="links">
        {links.map(([href, t, d]) => (
          <li><a href={href}><span class="t">{t}</span><span class="d">{d}</span><span class="arr" aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero { padding: 96px 0 80px; max-width: 820px; }
  .eyebrow { font-size: 14px; color: var(--ink-3); margin-bottom: 20px; }
  h1 { font-size: clamp(36px, 5.6vw, 64px); line-height: 1.15; font-weight: 600; letter-spacing: -0.025em; }
  .lead { font-size: clamp(17px, 1.6vw, 20px); color: var(--ink-2); margin-top: 24px; max-width: 56ch; }
  .cta { display: flex; gap: 12px; margin-top: 36px; flex-wrap: wrap; }
  .cta .btn { min-height: 48px; padding: 12px 26px; font-size: 16px; }
  .block { border-top: 1px solid var(--line); padding: 48px 0 56px; }
  .gap { height: 24px; }
  .steps { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .n { font-size: 14px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .steps h3 { margin: 10px 0 6px; font-size: 17px; }
  .steps p { color: var(--ink-2); font-size: 15px; }
  .links { list-style: none; margin: 20px 0 0; padding: 0; }
  .links a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto; gap: 16px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .links li:first-child a { border-top: 1px solid var(--line); }
  .links .t { font-size: 20px; font-weight: 500; }
  .links .d { color: var(--ink-3); }
  .links .arr { transition: transform .2s var(--ease); color: var(--ink-3); }
  .links a:hover .arr { transform: translateX(4px); color: var(--ink); }
  @media (max-width: 860px) {
    .hero { padding: 56px 0 48px; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .links a { grid-template-columns: minmax(0, 1fr) auto; }
    .links .d { grid-column: 1; grid-row: 2; }
    .links .arr { grid-row: 1 / 3; grid-column: 2; align-self: center; }
  }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
