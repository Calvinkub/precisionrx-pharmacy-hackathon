---
import MainLayout from "../layouts/MainLayout.astro";
import Meter from "../components/Meter.astro";
import Sources from "../components/Sources.astro";
import StatusChip from "../components/StatusChip.astro";
import SourceBadge from "../components/SourceBadge.astro";
import Trace from "../components/Trace.astro";
import CheckTrace from "../components/CheckTrace.astro";
import LineageMatrix from "../components/LineageMatrix.astro";
import c from "../data/computed.json";

const r = c.risks, t = c.traces;
const tone = (cat: string) => ({ low: "good", moderate: "warn", high: "bad", very_high: "bad", present: "bad", at_risk: "warn", absent: "good" } as Record<string, "good" | "warn" | "bad">)[cat] ?? "info";
const met = r.mets.met;
const R = 64, CIRC = 2 * Math.PI * R;
const uniq = (xs: { src: number }[]) => [...new Set(xs.map((x) => x.src))].sort();
const lineage = [
  { label: "กลุ่มอาการเมตาบอลิก", href: "#h-mets", srcs: uniq(t.mets.inputs) },
  { label: "เบาหวาน", href: "#risk-dm", srcs: uniq(t.diabetes.inputs) },
  { label: "หัวใจและหลอดเลือด", href: "#risk-cvd", srcs: uniq(t.cvd.inputs) },
  { label: "ไขมันพอกตับ (FLI)", href: "#risk-liver", srcs: uniq(t.liver.inputs) },
  { label: "พังผืดตับ (FIB-4)", href: "#risk-liver", srcs: uniq(t.fib4.inputs) },
  { label: "รูปแบบดื้ออินซูลิน", href: "/metabolomics/", srcs: uniq(t.insulin_resistance.inputs) },
  { label: "คุณภาพตัวอย่าง cfDNA", href: "/molecular/", srcs: [5] },
  { label: "สัญญาณตับจาก cfDNA", href: "/molecular/", srcs: ["mock" as const] },
];
---
<MainLayout title="ภาพรวมความเสี่ยง" current="overview">
  <p class="eyebrow">ภาพรวมความเสี่ยง</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">ความเสี่ยงที่ปรับได้ด้วยพฤติกรรม</h1>

  <div class="mt-8 grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <section class="card flex flex-col items-center text-center" aria-labelledby="h-mets">
      <h2 id="h-mets" class="eyebrow self-start">กลุ่มอาการเมตาบอลิก</h2>
      <svg viewBox="0 0 160 160" class="mt-4 w-44 h-44" role="img" aria-label={`เข้าเกณฑ์ ${met} จาก 5 ข้อ`}>
        <circle cx="80" cy="80" r={R} fill="none" stroke="var(--band)" stroke-width="12" />
        <circle cx="80" cy="80" r={R} fill="none" stroke={met >= 3 ? "var(--bad-dot)" : met === 2 ? "var(--warn-dot)" : "var(--good)"} stroke-width="12"
                stroke-linecap="round" stroke-dasharray={`${(met / 5) * CIRC} ${CIRC}`} transform="rotate(-90 80 80)" />
        <text x="80" y="78" text-anchor="middle" class="fill-ink" style="font-size:40px;font-weight:600">{met}<tspan style="font-size:20px" class="fill-ink-3">/5</tspan></text>
        <text x="80" y="104" text-anchor="middle" class="fill-ink-3" style="font-size:12px">เกณฑ์</text>
      </svg>
      <div class="mt-2"><StatusChip tone={tone(r.mets.category)} label={r.mets.label} /></div>
      <div class="mt-5 w-full text-left"><CheckTrace inputs={t.mets.inputs} result={t.mets.result} rule="≥ 3 ข้อ = เข้าเกณฑ์" /></div>
      <p class="mt-3 self-start text-xs text-ink-3"><Sources ids={r.mets.fact_ids} /></p>
    </section>

    <section class="card" aria-labelledby="h-risk">
      <h2 id="h-risk" class="eyebrow">ความเสี่ยงรายโรค</h2>
      <ul class="mt-4 divide-y divide-line">
        <li id="risk-dm" class="py-4 first:pt-0">
          <div class="flex items-baseline justify-between gap-3"><h3 class="flex flex-wrap items-center gap-1.5 font-medium">เบาหวานชนิดที่ 2<span class="inline-flex gap-1">{uniq(t.diabetes.inputs).map((n) => <SourceBadge no={n} />)}</span></h3><StatusChip tone={tone(r.diabetes.category)} label={r.diabetes.label} /></div>
          <p class="num mt-1 text-2xl font-medium">{r.diabetes.display}<span class="ml-2 text-sm font-normal text-ink-3">{r.diabetes.band}</span></p>
          <div class="mt-2"><Meter value={r.diabetes.value} max={17} tone={tone(r.diabetes.category)} ticks={[2.5, 5.5, 8.5]} label={`คะแนน ${r.diabetes.value} จาก 17`} /></div>
          <p class="mt-2 text-xs text-ink-3">{r.diabetes.method} · {c.prediabetes ? "และน้ำตาลอยู่ในช่วงก่อนเบาหวานแล้ว · " : ""}<Sources ids={[...r.diabetes.fact_ids, "ADA-2026-DX"]} /></p>
          <details class="group mt-3 rounded-2xl bg-subtle">
            <summary class="cursor-pointer list-none px-4 py-2.5 text-sm font-medium text-ink-2 [&::-webkit-details-marker]:hidden"><span class="inline-block transition-transform group-open:rotate-90" aria-hidden="true">›</span> ตัวเลขนี้มาจากไหน</summary>
            <div class="px-4 pb-4"><Trace inputs={t.diabetes.inputs} result={t.diabetes.result} scale="คะแนน · ≥ 9 = สูงมาก" /></div>
          </details>
        </li>
        <li id="risk-cvd" class="py-4">
          <div class="flex items-baseline justify-between gap-3"><h3 class="flex flex-wrap items-center gap-1.5 font-medium">โรคหัวใจและหลอดเลือด (10 ปี)<span class="inline-flex gap-1">{uniq(t.cvd.inputs).map((n) => <SourceBadge no={n} />)}</span></h3><StatusChip tone={tone(r.cvd.category)} label={r.cvd.label} /></div>
          <p class="num mt-1 text-2xl font-medium">{r.cvd.display}</p>
          <div class="mt-2"><Meter value={r.cvd.value} max={40} tone={tone(r.cvd.category)} ticks={[10, 20, 30]} label={`ความเสี่ยง ${r.cvd.display}`} /></div>
          <p class="mt-2 text-xs text-ink-3">{r.cvd.method} · <Sources ids={r.cvd.fact_ids} /></p>
          <details class="group mt-3 rounded-2xl bg-subtle">
            <summary class="cursor-pointer list-none px-4 py-2.5 text-sm font-medium text-ink-2 [&::-webkit-details-marker]:hidden"><span class="inline-block transition-transform group-open:rotate-90" aria-hidden="true">›</span> ตัวเลขนี้มาจากไหน</summary>
            <div class="px-4 pb-4"><Trace inputs={t.cvd.inputs} result={t.cvd.result} base={t.cvd.base} baseLabel={t.cvd.base_label} scale="เท่า" /></div>
          </details>
        </li>
        <li id="risk-liver" class="py-4 last:pb-0">
          <div class="flex items-baseline justify-between gap-3"><h3 class="flex flex-wrap items-center gap-1.5 font-medium">ไขมันพอกตับ<span class="inline-flex gap-1">{uniq(t.liver.inputs).map((n) => <SourceBadge no={n} />)}</span></h3><StatusChip tone={tone(r.liver.category)} label={r.liver.label} /></div>
          <p class="num mt-1 text-2xl font-medium">FLI {Math.round(r.liver.fli)}<span class="ml-2 text-sm font-normal text-ink-3">จาก 100</span></p>
          <div class="mt-2"><Meter value={r.liver.fli} max={100} tone={tone(r.liver.category)} ticks={[30, 60]} label={`Fatty Liver Index ${Math.round(r.liver.fli)}`} /></div>
          <p class="mt-2 text-xs text-ink-3">{r.liver.notes.join(" · ")} · <Sources ids={r.liver.fact_ids} /></p>
          <details class="group mt-3 rounded-2xl bg-subtle">
            <summary class="cursor-pointer list-none px-4 py-2.5 text-sm font-medium text-ink-2 [&::-webkit-details-marker]:hidden"><span class="inline-block transition-transform group-open:rotate-90" aria-hidden="true">›</span> ตัวเลขนี้มาจากไหน</summary>
            <div class="px-4 pb-4"><Trace inputs={t.liver.inputs} result={t.liver.result} base={t.liver.base} baseLabel={t.liver.base_label} scale="เท่าของ odds" />
              <p class="mt-4 text-xs text-ink-3">FIB-4 = {t.fib4.formula}</p>
              <p class="mt-1.5 flex flex-wrap items-center gap-1.5 text-sm">{t.fib4.inputs.map((i) => <span class="inline-flex items-center gap-1 rounded-full bg-card px-2 py-0.5"><SourceBadge no={i.src} />{i.label} <span class="num">{i.value}</span></span>)}<span aria-hidden="true">→</span><strong class="num">{t.fib4.result}</strong><span class="text-xs text-ink-3">(&lt; {t.fib4.cut} ต่ำ)</span></p></div>
          </details>
        </li>
      </ul>
    </section>
  </div>

  <section class="card mt-3" aria-labelledby="h-lineage">
    <h2 id="h-lineage" class="eyebrow">ผลแต่ละข้อใช้ข้อมูลจากแหล่งไหน</h2>
    <div class="mt-4"><LineageMatrix rows={lineage} /></div>
    <p class="mt-3 text-xs text-ink-3">คำนวณด้วยสูตรที่ตีพิมพ์ ไม่มีโมเดลกล่องดำ · ใส่ค่าเดิมได้ผลเดิมทุกครั้ง</p>
  </section>
</MainLayout>
