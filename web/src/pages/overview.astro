---
import MainLayout from "../layouts/MainLayout.astro";
import Meter from "../components/Meter.astro";
import Sources from "../components/Sources.astro";
import StatusChip from "../components/StatusChip.astro";
import mock from "../data/mockPatient.json";
import c from "../data/computed.json";
import { ArrowRight, Dna, Droplet, FlaskConical, Target } from "@lucide/astro";

const r = c.risks;
const tone = (cat: string) => ({ low: "good", moderate: "warn", high: "bad", very_high: "bad", present: "bad", at_risk: "warn", absent: "good" } as Record<string, "good" | "warn" | "bad">)[cat] ?? "info";
const met = r.mets.met;
const R = 64, CIRC = 2 * Math.PI * R;
const drivers = [
  { icon: FlaskConical, title: "กรดอะมิโนกลุ่ม BCAA สูง", detail: `Valine ${mock.nmr.valine.value}, Isoleucine ${mock.nmr.isoleucine.value}, Leucine ${mock.nmr.leucine.value} µmol/L — เหนือ P90 ของประชากร`, facts: ["BCAA-T2D"], href: "/metabolomics/" },
  { icon: Droplet, title: "น้ำตาลอยู่ในช่วงก่อนเบาหวาน", detail: `FPG ${mock.labs.glucose_mg_dl} mg/dL · HbA1c ${mock.labs.hba1c_pct}% (ช่วงก่อนเบาหวาน 100–125 / 5.7–6.4)`, facts: ["ADA-2026-DX"], href: "/metabolomics/" },
  { icon: FlaskConical, title: "อนุภาค LDL ขนาดเล็กสูง", detail: `Small LDL-P ${mock.nmr.small_ldl_p.value} nmol/L — เกินเปอร์เซ็นไทล์ที่ 75 · TG ${mock.labs.tg_mg_dl} mg/dL`, facts: ["OTVOS-2011-DISCORDANCE"], href: "/metabolomics/" },
  { icon: Target, title: "รอบเอวและ BMI เกินเกณฑ์", detail: `รอบเอว ${mock.profile.waist_cm} ซม. · BMI ${c.bmi}`, facts: ["THAI-OBESITY"], href: "/" },
  { icon: Dna, title: "สัญญาณ cfDNA (ตัวอย่างหน้าตารายงาน)", detail: "ค่าตัวอย่าง ไม่ได้คำนวณโดยระบบ — ดูรายละเอียดและข้อควรระวัง", facts: ["CFDNA-FRAGMENTOMICS-SEQ"], href: "/molecular/" },
];
---
<MainLayout title="ภาพรวมความเสี่ยง" current="overview">
  <p class="eyebrow">ภาพรวมความเสี่ยง</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">ความเสี่ยงที่ปรับได้ด้วยพฤติกรรม</h1>

  <div class="mt-8 grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <section class="card flex flex-col items-center text-center" aria-labelledby="h-mets">
      <h2 id="h-mets" class="eyebrow self-start">กลุ่มอาการเมตาบอลิก</h2>
      <svg viewBox="0 0 160 160" class="mt-4 w-44 h-44" role="img" aria-label={`เข้าเกณฑ์ ${met} จาก 5 ข้อ`}>
        <circle cx="80" cy="80" r={R} fill="none" stroke="var(--band)" stroke-width="12" />
        <circle cx="80" cy="80" r={R} fill="none" stroke={met >= 3 ? "var(--bad-dot)" : met === 2 ? "var(--warn-dot)" : "var(--good)"} stroke-width="12"
                stroke-linecap="round" stroke-dasharray={`${(met / 5) * CIRC} ${CIRC}`} transform="rotate(-90 80 80)" />
        <text x="80" y="78" text-anchor="middle" class="fill-ink" style="font-size:40px;font-weight:600">{met}<tspan style="font-size:20px" class="fill-ink-3">/5</tspan></text>
        <text x="80" y="104" text-anchor="middle" class="fill-ink-3" style="font-size:12px">เกณฑ์</text>
      </svg>
      <div class="mt-2"><StatusChip tone={tone(r.mets.category)} label={r.mets.label} /></div>
      <ul class="mt-5 w-full space-y-1.5 text-left text-sm">
        {r.mets.criteria.map((k) => (
          <li class="flex items-center justify-between gap-2"><span class:list={[k.met ? "text-ink" : "text-ink-3"]}>{k.met ? "●" : "○"} {k.label}</span><span class="num text-ink-3">{k.value} {k.unit}</span></li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-ink-3">เข้าเกณฑ์เมื่อมีอย่างน้อย 3 ใน 5 ข้อ · <Sources ids={r.mets.fact_ids} /></p>
    </section>

    <section class="card" aria-labelledby="h-risk">
      <h2 id="h-risk" class="eyebrow">ความเสี่ยงรายโรค</h2>
      <ul class="mt-4 divide-y divide-line">
        <li class="py-4 first:pt-0">
          <div class="flex items-baseline justify-between gap-3"><h3 class="font-medium">เบาหวานชนิดที่ 2</h3><StatusChip tone={tone(r.diabetes.category)} label={r.diabetes.label} /></div>
          <p class="num mt-1 text-2xl font-medium">{r.diabetes.display}<span class="ml-2 text-sm font-normal text-ink-3">{r.diabetes.band}</span></p>
          <div class="mt-2"><Meter value={r.diabetes.value} max={17} tone={tone(r.diabetes.category)} ticks={[2.5, 5.5, 8.5]} label={`คะแนน ${r.diabetes.value} จาก 17`} /></div>
          <p class="mt-2 text-xs text-ink-3">{r.diabetes.method} · {c.prediabetes ? "และน้ำตาลอยู่ในช่วงก่อนเบาหวานแล้ว · " : ""}<Sources ids={[...r.diabetes.fact_ids, "ADA-2026-DX"]} /></p>
        </li>
        <li class="py-4">
          <div class="flex items-baseline justify-between gap-3"><h3 class="font-medium">โรคหัวใจและหลอดเลือด (10 ปี)</h3><StatusChip tone={tone(r.cvd.category)} label={r.cvd.label} /></div>
          <p class="num mt-1 text-2xl font-medium">{r.cvd.display}</p>
          <div class="mt-2"><Meter value={r.cvd.value} max={40} tone={tone(r.cvd.category)} ticks={[10, 20, 30]} label={`ความเสี่ยง ${r.cvd.display}`} /></div>
          <p class="mt-2 text-xs text-ink-3">{r.cvd.method} · <Sources ids={r.cvd.fact_ids} /></p>
        </li>
        <li class="py-4 last:pb-0">
          <div class="flex items-baseline justify-between gap-3"><h3 class="font-medium">ไขมันพอกตับ</h3><StatusChip tone={tone(r.liver.category)} label={r.liver.label} /></div>
          <p class="num mt-1 text-2xl font-medium">FLI {Math.round(r.liver.fli)}<span class="ml-2 text-sm font-normal text-ink-3">จาก 100</span></p>
          <div class="mt-2"><Meter value={r.liver.fli} max={100} tone={tone(r.liver.category)} ticks={[30, 60]} label={`Fatty Liver Index ${Math.round(r.liver.fli)}`} /></div>
          <p class="mt-2 text-xs text-ink-3">{r.liver.notes.join(" · ")} · <Sources ids={r.liver.fact_ids} /></p>
        </li>
      </ul>
    </section>
  </div>

  <section class="card mt-3" aria-labelledby="h-drivers">
    <h2 id="h-drivers" class="eyebrow">ปัจจัยหลักที่ดันความเสี่ยง</h2>
    <ul class="mt-4 grid gap-2 md:grid-cols-2">
      {drivers.map((d) => (
        <li class="rounded-2xl bg-subtle p-4">
          <a href={d.href} class="group flex items-start gap-3 text-ink no-underline">
            <d.icon size={20} class="mt-0.5 shrink-0 text-ink-3" aria-hidden="true" />
            <span class="min-w-0"><span class="font-medium">{d.title}</span><span class="block text-sm text-ink-2">{d.detail}</span></span>
            <ArrowRight size={16} class="ml-auto mt-1 shrink-0 text-ink-3 group-hover:translate-x-0.5 transition-transform" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-xs text-ink-3">คะแนนเบาหวาน: {r.diabetes.contributions.map((k) => `${k.label} +${k.points}`).join(" · ")}</p>
  </section>
</MainLayout>
