---
import MainLayout from "../layouts/MainLayout.astro";
import Meter from "../components/Meter.astro";
import Sources from "../components/Sources.astro";
import StatusChip from "../components/StatusChip.astro";
import SourceBadge from "../components/SourceBadge.astro";
import Electropherogram from "../components/Electropherogram.astro";
import mock from "../data/mockPatient.json";
import c from "../data/computed.json";
import { TriangleAlert } from "@lucide/astro";

const d = mock.cfdna_mock;
const run = c.cfdna_run;
// measured by the CE instrument (source 5), QC rules from app/engines/cfdna_qc.py
const measured = [
  { label: "Mean fragment size", value: run.average_size_bp, unit: "bp", ok: run.average_size_bp >= 155 && run.average_size_bp <= 180, rule: "Reference ≈ 167 bp (mononucleosome)" },
  { label: "Concentration", value: run.mean_conc_ng_ul.toFixed(2), unit: "ng/µL", ok: true, rule: `Total ${run.total_ng} ng in ${run.elution_ul} µL` },
  { label: "HMW DNA > 700 bp", value: (run.hmw_max * 100).toFixed(1), unit: "%", ok: run.hmw_max <= 0.1, rule: "Pass ≤ 10%" },
  { label: "Peak precision", value: run.peak_cv_pct, unit: "% CV", ok: run.peak_cv_pct <= 5, rule: `${run.replicates.length} replicates` },
];
const mocks = [
  { label: "Fragmentation score", value: d.fragmentation_score, max: 1, cut: d.mock_thresholds.fragmentation_score },
  { label: "Liver methylation", value: d.liver_methylation_score, max: 1, cut: d.mock_thresholds.liver_methylation_score },
  { label: "Tumor fraction", value: d.tumor_fraction_pct, unit: "%", max: null, cut: null },
];
---
<MainLayout title="cfDNA Pattern" current="molecular">
  <p class="eyebrow">Cell-free DNA</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">Cellular signal</h1>

  <section class="card mt-6" aria-labelledby="h-run">
    <h2 id="h-run" class="sr-only">cfDNA electropherogram</h2>
    <Electropherogram />
    <ul class="mt-5 grid grid-cols-2 gap-2 lg:grid-cols-4">
      {measured.map((m) => (
        <li class="rounded-2xl bg-subtle p-3.5">
          <p class="flex items-center gap-1.5 text-xs text-ink-3"><SourceBadge no={5} />{m.label}</p>
          <p class="num mt-1 text-2xl font-medium">{m.value}<span class="ml-1 text-xs font-normal text-ink-3">{m.unit}</span></p>
          <p class="mt-1 flex items-center gap-1.5 text-xs text-ink-3"><span class:list={["inline-block h-2 w-2 rounded-full", m.ok ? "bg-good" : "bg-warn-dot"]} aria-hidden="true"></span>{m.rule}</p>
        </li>
      ))}
    </ul>
    <p class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <StatusChip tone={run.qc_status === "pass" ? "good" : run.qc_status === "warning" ? "warn" : "bad"} label={run.qc_status === "pass" ? "Sample QC: pass" : run.qc_status === "warning" ? "Sample QC: warning" : "Sample QC: fail"} />
      <span class="text-xs text-ink-3">Pre-analytical quality only — not a diagnostic result · <Sources ids={["CFDNA-NUCLEOSOME", "CFDNA-HMW-QC", "CFDNA-FRAGMENTOMICS-SEQ"]} /></span>
    </p>
  </section>

  <section class="mt-4 rounded-3xl border border-dashed border-ink-3 p-5 sm:p-6" aria-labelledby="h-alert">
    <div class="flex items-start gap-3">
      <TriangleAlert size={22} class="mt-1 shrink-0 text-warn" aria-hidden="true" />
      <div>
        <p class="flex items-center gap-2"><SourceBadge no="mock" /><span class="text-xs text-ink-3">Not derived from the electropherogram — requires a validated sequencing / methylation assay</span></p>
        <h2 id="h-alert" class="mt-2 text-xl sm:text-2xl font-semibold">Liver-associated molecular signal</h2>
        <p class="mt-1 text-ink-2">ไม่ใช่ผลการวินิจฉัย ควรปรึกษาแพทย์ (ดูขั้นตอนถัดไปในแท็บ <a href="/action-plan/" class="text-accent">Advices</a>)</p>
        <p class="mt-3"><StatusChip tone="warn" label={`Predicted tissue of origin: Liver · ${d.origin_confidence_pct}%`} /></p>
      </div>
    </div>
    <ul class="mt-5 grid gap-2 sm:grid-cols-3">
      {mocks.map((m) => (
        <li class="rounded-2xl bg-subtle p-3.5">
          <p class="text-xs text-ink-3">{m.label}</p>
          <p class="num mt-1 text-2xl font-medium">{m.value}{m.unit && <span class="ml-1 text-xs font-normal text-ink-3">{m.unit}</span>}</p>
          {m.max !== null && m.cut !== null && <div class="mt-2"><Meter value={m.value} max={m.max} tone={m.value >= m.cut ? "warn" : "good"} ticks={[m.cut]} label={`${m.label} ${m.value}, example cut-off ${m.cut}`} /></div>}
        </li>
      ))}
    </ul>
  </section>


</MainLayout>
