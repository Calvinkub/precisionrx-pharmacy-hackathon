---
import Base from "../../layouts/Base.astro";
import CeRun from "../../components/CeRun.svelte";
import Cfdna from "../../components/Cfdna.svelte";
---
<Base title="cfDNA" current="cfdna" description="ผล electropherogram ของ cfDNA (QIAxcel) และรายงาน ctDNA + ยีนของผู้ป่วย + ยาตีกัน">
  <div class="container page">
    <h1 class="title">cfDNA</h1>
    <p class="sub">ผล electropherogram จากเครื่อง capillary electrophoresis และรายงาน ctDNA สำหรับทีมมะเร็ง</p>
    <nav class="jump" aria-label="ในหน้านี้"><a href="#ce">ผล Electropherogram</a><a href="#ctdna">ctDNA + ยา</a></nav>
    <section id="ce" class="block" aria-label="ผล Electropherogram">
      <h2>ผล Electropherogram</h2>
      <div class="gap"></div>
      <CeRun client:load />
    </section>
    <section id="ctdna" class="block" aria-label="ctDNA และยา">
      <h2>ctDNA + ยีนของผู้ป่วย + ยาตีกัน</h2>
      <div class="gap"></div>
      <Cfdna client:load />
    </section>
  </div>
</Base>
<style>
  .title { margin-bottom: 8px; }
  .sub { color: var(--ink-2); max-width: 62ch; }
  .jump { display: flex; gap: 20px; margin: 16px 0 8px; font-size: 14.5px; }
  .block { border-top: 1px solid var(--line); padding: 32px 0 16px; margin-top: 16px; scroll-margin-top: 80px; }
  .gap { height: 16px; }
</style>
