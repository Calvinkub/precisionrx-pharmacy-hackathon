---
import MainLayout from "../layouts/MainLayout.astro";
import StatusChip from "../components/StatusChip.astro";
import Sources from "../components/Sources.astro";
import mock from "../data/mockPatient.json";
import { Cigarette, HeartPulse, Scale, Target } from "@lucide/astro";

const p = mock.profile;
// cut-offs: Thai obesity (BMI ≥ 25 obesity, 23–24.9 overweight; waist ≥ 90 M / ≥ 80 F) · Thai HT 2024 (130–139/85–89 high-normal, ≥ 140/90 hypertension)
const bmi = p.bmi;
const bmiTone = bmi >= 25 ? "bad" : bmi >= 23 ? "warn" : "good";
const waistCut = p.sex === "male" ? 90 : 80;
const bpTone = p.sbp >= 140 || p.dbp >= 90 ? "bad" : p.sbp >= 130 || p.dbp >= 85 ? "warn" : "good";
const cards = [
  { icon: Scale, label: "BMI", value: bmi, unit: "kg/m²", tone: bmiTone, chip: bmiTone === "bad" ? "Obesity" : bmiTone === "warn" ? "Overweight" : "Normal", sub: "Normal 18.5–22.9 (Asian)" },
  { icon: Target, label: "Waist circumference", value: p.waist_cm, unit: "cm", tone: p.waist_cm >= waistCut ? "warn" : "good", chip: p.waist_cm >= waistCut ? "Above cut-off" : "Normal", sub: `Cut-off < ${waistCut} cm` },
  { icon: HeartPulse, label: "Blood pressure", value: `${p.sbp}/${p.dbp}`, unit: "mmHg", tone: bpTone, chip: bpTone === "bad" ? "Hypertension" : bpTone === "warn" ? "High-normal" : "Normal", sub: "Normal < 130/85" },
] as const;
const smoking = { "ex-smoker": "Ex-smoker", current: "Current smoker", never: "Never smoked" }[p.smoking] ?? p.smoking;
---
<MainLayout title="Identification data" current="identification">
  <p class="eyebrow">Identification data · ตัวอย่าง</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">{p.name}</h1>
  <p class="mt-1 text-ink-2">{p.age} ปี · {p.sex === "male" ? "ชาย" : "หญิง"}</p>

  <section aria-label="Vital signs" class="mt-8 grid gap-3 sm:grid-cols-3">
    {cards.map((k) => (
      <article class="card flex flex-col gap-2">
        <div class="flex items-center justify-between text-ink-3"><span class="text-sm">{k.label}</span><k.icon size={18} aria-hidden="true" /></div>
        <p class="num text-3xl font-medium tracking-tight">{k.value}<span class="ml-1 text-sm text-ink-3 font-normal">{k.unit}</span></p>
        <div><StatusChip tone={k.tone} label={k.chip} /></div>
        <p class="text-xs text-ink-3">{k.sub}</p>
      </article>
    ))}
  </section>

  <section aria-label="Lifestyle" class="mt-3">
    <p class="inline-flex items-center gap-2 rounded-full bg-subtle px-3 py-1.5 text-sm"><Cigarette size={16} aria-hidden="true" />{smoking}</p>
  </section>
  <p class="mt-4 text-xs text-ink-3"><Sources ids={["THAI-OBESITY", "THAI-HT-2024-NA"]} /></p>

  <a href="/metabolomics/" class="btn btn-primary mt-8 no-underline">Metabolites Profile →</a>
</MainLayout>
