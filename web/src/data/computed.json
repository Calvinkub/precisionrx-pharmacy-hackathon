 "facts": {
  "ADA-2026-DX": {
   "text": "Prediabetes: FPG 5.6–6.9 mmol/L (100–125 mg/dL); diabetes: FPG ≥7.0 mmol/L (≥126 mg/dL)",
   "source": "ADA Standards of Care 2026, Section 2",
   "url": "https://diabetesjournals.org/care/article/49/Supplement_1/S27/163926/2-Diagnosis-and-Classification-of-Diabetes",
   "level": "guideline",
   "verified": true
  },
  "ADA-2026-PREV": {
   "text": "Prediabetes: weight reduction of at least 5–7% and ≥150 min/week moderate-intensity physical activity",
   "source": "ADA Standards of Care 2026, Section 3 (rec. 3.3)",
   "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12690170/",
   "level": "guideline",
   "verified": true
  },
  "BCAA-T2D": {
   "text": "Branched-chain amino acids (NMR) predicted type 2 diabetes, OR 1.31–1.33 per SD after adjusting for BMI and fasting glucose (young Finns, n=11,896)",
   "source": "Ahola-Olli 2019 Diabetologia",
   "url": "https://pubmed.ncbi.nlm.nih.gov/31584131/",
   "level": "emerging",
   "verified": true
  },
  "CFDNA-FRAGMENTOMICS-SEQ": {
   "text": "Validated fragmentomics cancer detection (DELFI) uses low-coverage whole-genome sequencing (1–2×), not capillary electrophoresis. A Thai CE-feature + AFP machine-learning study for liver-cancer surveillance (n=69 external validation, AUC 0.93) is single-centre research without regulatory clearance; no validated CE-only multi-cancer screening method was found",
   "source": "Cristiano S et al. Nature 2019; CEliver, Communications Medicine 2026",
   "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6774252/",
   "level": "emerging",
   "verified": true
  },
  "CFDNA-HMW-QC": {
   "text": "DNA above ~700 bp is high-molecular-weight genomic DNA outside the cfDNA region; leukocyte lysis (e.g. EDTA blood stored > 4 h) raises background DNA. The 10% / 20% flag thresholds used here are a PrecisionRx demo assumption, not a published cut-off",
   "source": "Pisareva E et al. 2021 (pre-analytics); Agilent cfDNA ScreenTape region definition (50–700 bp)",
   "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8525023/",
   "level": "assumption",
   "verified": true
  },
  "CFDNA-NUCLEOSOME": {
   "text": "Plasma cfDNA shows a dominant peak at ~166–167 bp (nucleosome-bound DNA) with ~10 bp periodicity",
   "source": "Lo YMD et al. Sci Transl Med 2010; Snyder MW et al. Cell 2016",
   "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4715266/",
   "level": "guideline",
   "verified": true
  },
  "ESC-2021-DIET": {
   "text": "Adopting a Mediterranean or similar diet is recommended to lower the risk of cardiovascular disease (more vegetables, fruit, whole grains, legumes, nuts, fish and olive oil; less red/processed meat and sugar)",
   "source": "2021 ESC Guidelines on cardiovascular disease prevention in clinical practice",
   "url": "https://academic.oup.com/eurheartj/article/42/34/3227/6358713",
   "level": "guideline",
   "verified": false
  },
  "FIB4-MASLD": {
   "text": "FIB-4 = age × AST / (platelets [10^9/L] × √ALT). Below 1.3 low risk of advanced fibrosis (re-assess every 1–3 years); 1.3–2.67 intermediate; above 2.67 high; in people older than 65 the lower cut-off is 2.0",
   "source": "EASL-EASD-EASO Clinical Practice Guidelines on MASLD 2024",
   "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11299976/",
   "level": "guideline",
   "verified": true
  },
  "FLI-2006": {
   "text": "Fatty Liver Index = e^y/(1+e^y) × 100, y = 0.953·ln(TG mg/dL) + 0.139·BMI + 0.718·ln(GGT U/L) + 0.053·waist(cm) − 15.745; FLI <30 rules out (LR− 0.2), ≥60 rules in fatty liver (LR+ 4.3). Developed in an Italian cohort",
   "source": "Bedogni G et al. BMC Gastroenterology 2006;6:33",
   "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC1636651/",
   "level": "validated_score",
   "verified": true
  },
  "METS-HARMONIZED-2009": {
   "text": "Harmonized metabolic syndrome: ≥3 of 5 — waist (Asian ≥90 cm men / ≥80 cm women), TG ≥150 mg/dL or treatment, HDL <40 (men) / <50 (women) mg/dL or treatment, BP ≥130/85 or treatment, fasting glucose ≥100 mg/dL or treatment",
   "source": "Alberti KGMM et al. Circulation 2009;120:1640 (thresholds confirmed from abstract and secondary sources; original Table 1 not opened)",
