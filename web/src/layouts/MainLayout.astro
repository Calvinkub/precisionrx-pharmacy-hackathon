---
import "../styles/app.css";
import { CalendarCheck, Dna, FlaskConical, Orbit, UserRound } from "@lucide/astro";

interface Props { title: string; current: "home" | "identification" | "metabolomics" | "molecular" | "action-plan"; description?: string }
const { title, current, description = "Multi-Omics — ภาพรวมสุขภาพจากผล NMR และ cfDNA (ข้อมูลตัวอย่าง)" } = Astro.props;
const tabs = [
  { id: "identification", href: "/identification/", label: "Identification data", short: "ข้อมูล", icon: UserRound },
  { id: "metabolomics", href: "/metabolomics/", label: "Metabolites Profile", short: "Metabolites", icon: FlaskConical },
  { id: "molecular", href: "/molecular/", label: "cfDNA Pattern", short: "cfDNA", icon: Dna },
  { id: "action-plan", href: "/action-plan/", label: "Advices", short: "Advices", icon: CalendarCheck },
];
const mobileTabs = [{ id: "home", href: "/", label: "ภาพรวม", short: "ภาพรวม", icon: Orbit }, ...tabs];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Multi-Omics</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='%230b0f17'/><circle cx='16' cy='16' r='6' fill='%2306b6d4'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-ink focus:px-4 focus:py-2 focus:text-bg">ข้ามไปยังเนื้อหาหลัก</a>
    <header class="no-print sticky top-0 z-30 border-b border-line bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 sm:px-6 h-16">
        <a href="/" aria-current={current === "home" ? "page" : undefined} class="flex items-center gap-2.5 font-semibold tracking-tight text-ink no-underline shrink-0">
          <span class="orb" aria-hidden="true"></span> Multi-Omics
        </a>
        <nav aria-label="เมนูหลัก" class="ml-auto hidden md:block">
          <ul class="flex gap-1">
            {tabs.map((t) => (
              <li>
                <a href={t.href} aria-current={current === t.id ? "page" : undefined}
                   class:list={["flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2 text-sm no-underline transition-colors",
                     "tab", current === t.id ? "tab-active text-ink" : "text-ink-2 hover:text-ink"]}>
                  <t.icon size={16} aria-hidden="true" />{t.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button id="theme-toggle" type="button" class="ml-auto md:ml-0 shrink-0 grid h-10 w-10 place-items-center rounded-full text-ink-3 hover:bg-subtle hover:text-ink" aria-label="สลับโหมดสว่างหรือมืด">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
        </button>
      </div>
    </header>
    <!-- mobile: bottom tab bar -->
    <nav aria-label="เมนูหลัก (มือถือ)" class="no-print md:hidden fixed inset-x-0 bottom-0 z-30 border-t border-line bg-bg/95 backdrop-blur-md pb-[env(safe-area-inset-bottom)]">
      <ul class="grid grid-cols-5">
        {mobileTabs.map((t) => (
          <li>
            <a href={t.href} aria-current={current === t.id ? "page" : undefined}
               class:list={["flex flex-col items-center gap-0.5 py-2 text-[11px] no-underline", current === t.id ? "text-accent font-semibold" : "text-ink-3"]}>
              <t.icon size={22} aria-hidden="true" />{t.short}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <main id="main" tabindex="-1" class="mx-auto max-w-6xl px-4 sm:px-6 py-8 sm:py-10 pb-28 md:pb-10 outline-none">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-4 sm:px-6 pb-24 md:pb-12">
      <p class="border-t border-line pt-6 text-xs text-ink-3">ข้อมูลตัวอย่างเพื่อสาธิต ไม่ใช่การวินิจฉัย · ความเสี่ยงคำนวณด้วยสูตรที่ validate แล้ว · ปรึกษาแพทย์หรือเภสัชกรก่อนปรับยาหรือพฤติกรรม</p>
    </footer>
    <style is:global>
      .orb { width: 18px; height: 18px; border-radius: 999px; background: radial-gradient(circle at 35% 35%, #a5f3fc, var(--accent) 55%, color-mix(in srgb, var(--accent) 30%, transparent));
        box-shadow: 0 0 calc(var(--glow) * 14px + 2px) color-mix(in srgb, var(--accent) 70%, transparent); animation: orb 3.6s ease-in-out infinite; }
      @keyframes orb { 50% { box-shadow: 0 0 calc(var(--glow) * 24px + 2px) color-mix(in srgb, var(--accent) 85%, transparent); } }
      .tab { position: relative; }
      .tab:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); box-shadow: 0 0 calc(var(--glow) * 18px) color-mix(in srgb, var(--accent) 18%, transparent); }
      .tab-active { background: color-mix(in srgb, var(--accent) 14%, transparent); }
      .tab-active::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: -13px; height: 2px; border-radius: 2px; background: var(--accent);
        box-shadow: 0 0 calc(var(--glow) * 10px) var(--accent); }
    </style>
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme !== "light";
        root.dataset.theme = dark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch { /* storage unavailable */ }
      });
    </script>
  </body>
</html>
