---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "dashboard" | "medications" | "care" | "cfdna";
}
const { title, description = "PrecisionRx — ต้นแบบระบบช่วยเภสัชกรตัดสินใจเรื่องยา (ข้อมูลจำลอง)", current } = Astro.props;
const nav = [
  { id: "dashboard", href: "/dashboard/", label: "ผลตรวจ", carry: true },
  { id: "medications", href: "/medications/", label: "ยาที่ใช้", carry: true },
  { id: "care", href: "/care/", label: "ความเสี่ยงและการดูแล", carry: true },
  { id: "cfdna", href: "/cfdna/", label: "cfDNA", carry: false },
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · PrecisionRx</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='%23161616'/><circle cx='16' cy='16' r='5' fill='%23fafaf9'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">ข้ามไปยังเนื้อหาหลัก</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-current={current === "home" ? "page" : undefined}>
          <span class="mark" aria-hidden="true"></span>PrecisionRx
        </a>
        <nav aria-label="เมนูหลัก">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} data-carry={n.carry ? "" : undefined} aria-current={current === n.id ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <button id="theme-toggle" class="theme" type="button" aria-label="สลับโหมดสว่างหรือมืด">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
        </button>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>ต้นแบบสำหรับ hackathon · ข้อมูลทั้งหมดเป็นข้อมูลจำลอง · ไม่ใช่เครื่องมือวินิจฉัย ทุกคำแนะนำต้องผ่านเภสัชกรหรือแพทย์</p>
      </div>
    </footer>

    <script>
      // keep the selected case + visit when moving between report pages
      const carry = () => {
        const q = new URLSearchParams(location.search);
        const c = q.get("case"), v = q.get("visit");
        if (!c) return;
        for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-carry]")) {
          const u = new URL(a.href); u.searchParams.set("case", c); if (v) u.searchParams.set("visit", v); a.href = u.pathname + u.search;
        }
      };
      carry();
      window.addEventListener("casechange", carry);
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const isDark = root.dataset.theme === "dark" ||
          (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        root.dataset.theme = isDark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch { /* storage unavailable */ }
        window.dispatchEvent(new CustomEvent("themechange"));
      });
    </script>
  </body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .mark { width: 22px; height: 22px; border-radius: 7px; background: var(--ink); position: relative; }
  .mark::after { content: ""; position: absolute; inset: 7px; border-radius: 50%; background: var(--bg); }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 12px; color: var(--ink-3); text-decoration: none; font-size: 15px; border-radius: 999px; transition: color .15s; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] { color: var(--ink); font-weight: 500; background: var(--subtle); }
  .theme { width: 40px; height: 40px; display: grid; place-items: center; border: 0; background: none; color: var(--ink-3); border-radius: 50%; cursor: pointer; }
  .theme:hover { color: var(--ink); background: var(--subtle); }
  main { outline: none; }
  .site-footer { padding: 48px 0 56px; }
  .site-footer p { color: var(--ink-3); font-size: 13px; border-top: 1px solid var(--line); padding-top: 24px; }
  nav a { white-space: nowrap; }
  @media (max-width: 560px) {
    .bar { flex-wrap: wrap; gap: 0 8px; padding-top: 8px; }
    .theme { margin-left: auto; }
    nav { order: 3; flex-basis: 100%; margin: 0 0 6px -12px; }
  }
</style>
