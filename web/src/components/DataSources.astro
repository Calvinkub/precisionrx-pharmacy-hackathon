---
import SourceBadge from "./SourceBadge.astro";
import { ICONS, SOURCES } from "../lib/sources";
---
<section aria-labelledby="h-src">
  <h2 id="h-src" class="eyebrow">ข้อมูลของคุณมาจาก {SOURCES.length} แหล่ง</h2>
  <ol class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
    {SOURCES.map((s) => {
      const Icon = ICONS[s.id as keyof typeof ICONS];
      return (
        <li id={`src-${s.no}`} class="rounded-2xl border border-line bg-card p-3.5">
          <div class="flex items-center gap-2"><SourceBadge no={s.no} size="md" /><Icon size={18} class="text-ink-3" aria-hidden="true" /></div>
          <p class="mt-2 font-medium leading-snug">{s.name}</p>
          <p class="mt-0.5 text-xs text-ink-3 leading-snug">{s.device}</p>
          <p class="num mt-2 text-xs text-ink-3">{s.date}{s.sample_id ? ` · ${s.sample_id}` : ""}</p>
        </li>
      );
    })}
  </ol>
</section>
