---
// Hero: the person's measured markers orbiting the metabolic-syndrome core.
// Every number is read from the data files; hover / focus a node to focus the core on it.
import SourceBadge from "./SourceBadge.astro";
import mock from "../data/mockPatient.json";
import c from "../data/computed.json";

const n = mock.nmr, L = mock.labs, run = c.cfdna_run, met = c.risks.mets.met;
const S = 600, CX = 300, CY = 300;
type Node = {
  id: string; x: number; y: number; r: number; tone: "warn" | "accent"; name: string; short: string; value: string;
  detail: string; organ: string; src: number; mock?: string; blink?: boolean; ripple?: boolean; breathe?: number;
};
const nodes: Node[] = [
  { id: "glucose", x: 128, y: 150, r: 24, tone: "warn", name: "Glucose · HbA1c", short: "Glucose", value: `${L.glucose_mg_dl} · ${L.hba1c_pct}%`,
    detail: "ช่วงก่อนเบาหวาน (100–125 · 5.7–6.4)", organ: "ตับอ่อน · ตับ", src: 3 },
  { id: "bcaa", x: 478, y: 150, r: 28, tone: "warn", name: "BCAAs ↑", short: "BCAAs ↑", value: `V ${n.valine.value} · L ${n.leucine.value} · I ${n.isoleucine.value}`,
    detail: `เกิน P90 ทั้ง ${c.bcaa_high.length} ตัว (µmol/L)`, organ: "กล้ามเนื้อ · ตับ (ดื้ออินซูลิน)", src: 4, blink: true },
  { id: "ldl", x: 470, y: 452, r: 22 * Math.sqrt(n.small_ldl_p.value / n.small_ldl_p.high_above), tone: "warn", name: "Small LDL-P", short: "Small LDL-P",
    value: `${n.small_ldl_p.value} nmol/L`, detail: `เกิน P75 (${n.small_ldl_p.high_above})`, organ: "หลอดเลือด", src: 4, breathe: 1.08 },
  { id: "cfdna", x: 132, y: 452, r: 22, tone: "accent", name: "cfDNA", short: "cfDNA", value: `${run.average_size_bp} bp`,
    detail: run.qc_status === "pass" ? "ตัวอย่างผ่าน QC" : "ตัวอย่างไม่ผ่าน QC", organ: "เลือด", src: 5, ripple: true,
    mock: `fragmentation ${mock.cfdna_mock.fragmentation_score} · สัญญาณตับ ${mock.cfdna_mock.origin_confidence_pct}%` },
];
const links: [string, string][] = [["glucose", "bcaa"], ["bcaa", "ldl"], ["glucose", "ldl"]];
const at = (id: string) => nodes.find((x) => x.id === id)!;
const pct = (v: number) => `${(v / S) * 100}%`;
const R1 = 96, C1 = 2 * Math.PI * R1;
// deterministic star field
const stars = Array.from({ length: 46 }, (_, i) => ({ x: (i * 137.5) % S, y: (i * 89.3 + 40) % S, r: i % 5 ? 0.9 : 1.6, d: (i % 7) * 0.6 }));
---
<div class="nexus relative mx-auto aspect-square w-full max-w-[560px]" data-focus="core" id="nexus">
  <svg viewBox={`0 0 ${S} ${S}`} class="absolute inset-0 h-full w-full" aria-hidden="true">
    <defs>
      <radialGradient id="nx-core" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--warn)" stop-opacity="0.55" /><stop offset="100%" stop-color="var(--warn)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="nx-warn" cx="35%" cy="35%" r="70%"><stop offset="0%" stop-color="#fde68a" /><stop offset="60%" stop-color="var(--warn)" /><stop offset="100%" stop-color="var(--warn)" stop-opacity="0.6" /></radialGradient>
      <radialGradient id="nx-accent" cx="35%" cy="35%" r="70%"><stop offset="0%" stop-color="#a5f3fc" /><stop offset="60%" stop-color="var(--accent)" /><stop offset="100%" stop-color="var(--accent)" stop-opacity="0.6" /></radialGradient>
    </defs>
    {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} class="nx-star" style={`animation-delay:${s.d}s`} />)}
    <circle cx={CX} cy={CY} r="232" class="nx-orbit" />
    <circle cx={CX} cy={CY} r="176" class="nx-orbit nx-orbit-2" />
    {links.map(([a, b]) => <line x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} class="nx-web" />)}
    {nodes.map((k) => <line x1={k.x} y1={k.y} x2={CX} y2={CY} class="nx-link" data-link={k.id} stroke={k.tone === "warn" ? "var(--warn)" : "var(--accent)"} />)}
    <circle cx={CX} cy={CY} r="150" fill="url(#nx-core)" class="nx-pulse" />
    <g class="nx-spin"><circle cx={CX} cy={CY} r="118" class="nx-ring-dash" /></g>
    <circle cx={CX} cy={CY} r={R1} fill="var(--bg)" stroke="var(--band)" stroke-width="10" />
    <circle cx={CX} cy={CY} r={R1} fill="none" stroke="var(--warn)" stroke-width="10" stroke-linecap="round"
            stroke-dasharray={`${(met / 5) * C1} ${C1}`} transform={`rotate(-90 ${CX} ${CY})`} class="nx-arc" />
    {nodes.map((k) => (
      <g data-node-g={k.id}>
        {k.ripple && [0, 1, 2].map((i) => <circle cx={k.x} cy={k.y} r={k.r} class="nx-ripple" style={`animation-delay:${i * 0.9}s`} />)}
        <circle cx={k.x} cy={k.y} r={k.r + 10} fill={k.tone === "warn" ? "var(--warn)" : "var(--accent)"} opacity="0.12" class:list={[k.blink && "nx-blink"]} />
        <circle cx={k.x} cy={k.y} r={k.r} fill={`url(#nx-${k.tone})`} style={`color:var(--${k.tone})`} class:list={["nx-node", k.blink && "nx-blink", k.breathe && "nx-breathe"]} />
      </g>
    ))}
  </svg>

  <!-- core readout: default = metabolic syndrome; swaps to the focused node -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 flex w-[32%] -translate-x-1/2 -translate-y-1/2 flex-col items-center text-center" aria-live="polite">
    <div data-core="core" class="nx-core">
      <p class="num text-3xl sm:text-5xl font-semibold leading-none">{met}<span class="text-lg sm:text-2xl text-ink-3">/5</span></p>
      <p class="mt-1 text-[10px] sm:text-xs leading-tight text-ink-2">เกณฑ์กลุ่มอาการ<br />เมตาบอลิก</p>
    </div>
    {nodes.map((k) => (
      <div data-core={k.id} class="nx-core" hidden>
        <p class="text-[10px] sm:text-xs font-semibold text-ink-2">{k.short}</p>
        <p class="num mt-0.5 text-xs sm:text-base font-semibold leading-tight text-balance">{k.value}</p>
        <p class="mt-0.5 text-[9px] sm:text-[11px] leading-tight text-ink-3">{k.organ}</p>
      </div>
    ))}
  </div>

  {nodes.map((k) => (
    <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${pct(k.x)};top:${pct(k.y)}`}>
      <button type="button" data-node={k.id} aria-describedby={`nx-tip-${k.id}`}
              class="nx-hit grid place-items-center rounded-full" style={`width:${Math.max(44, (k.r + 12) * 2 * 0.93)}px;height:${Math.max(44, (k.r + 12) * 2 * 0.93)}px`}>
        <span class="sr-only">{k.name}</span>
      </button>
      <p class="pointer-events-none absolute left-1/2 top-full mt-0.5 -translate-x-1/2 whitespace-nowrap text-center text-[11px] sm:text-xs font-medium" aria-hidden="true">{k.short}</p>
      <div role="tooltip" id={`nx-tip-${k.id}`} data-tip={k.id}
           class:list={["nx-tip glass absolute z-10 w-56 rounded-2xl p-3 text-left text-xs shadow-xl", k.y < CY ? "bottom-full mb-2" : "top-full mt-7", k.x < CX ? "left-0" : "right-0"]}>
        <p class="flex items-center gap-1.5 font-semibold text-ink"><SourceBadge no={k.src} />{k.name}</p>
        <p class="num mt-1 text-sm text-ink">{k.value}</p>
        <p class="mt-0.5 text-ink-2">{k.detail}</p>
        <p class="mt-0.5 text-ink-3">เกี่ยวข้อง: {k.organ}</p>
        {k.mock && <p class="mt-1.5 flex items-center gap-1.5 text-ink-3"><SourceBadge no="mock" />{k.mock}</p>}
      </div>
    </div>
  ))}
</div>

<style>
  .nx-star { fill: var(--ink-3); opacity: calc(0.15 + var(--glow) * 0.25); animation: nx-twinkle 4s ease-in-out infinite; }
  @keyframes nx-twinkle { 50% { opacity: 0.08; } }
  .nx-orbit { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 6; }
  .nx-orbit-2 { stroke-dasharray: 1 10; }
  .nx-web { stroke: var(--ink-3); stroke-opacity: 0.3; stroke-width: 1; stroke-dasharray: 3 5; }
  .nx-link { stroke-width: 1.4; stroke-opacity: 0.45; stroke-dasharray: 3 9; animation: nx-flow 1.6s linear infinite; transition: stroke-opacity .2s, stroke-width .2s; }
  @keyframes nx-flow { to { stroke-dashoffset: -24; } }
  .nx-pulse, .nx-node, .nx-ripple, .nx-spin { transform-box: fill-box; transform-origin: center; }
  .nx-pulse { animation: nx-pulse 3.2s ease-in-out infinite; opacity: calc(0.35 + var(--glow) * 0.65); }
  @keyframes nx-pulse { 50% { transform: scale(1.12); opacity: calc(0.2 + var(--glow) * 0.4); } }
  .nx-spin { animation: nx-spin 48s linear infinite; }
  .nx-ring-dash { fill: none; stroke: var(--warn); stroke-opacity: 0.35; stroke-width: 1.5; stroke-dasharray: 1 7; }
  @keyframes nx-spin { to { transform: rotate(360deg); } }
  .nx-arc { filter: drop-shadow(0 0 calc(var(--glow) * 8px) var(--warn)); }
  .nx-node { filter: drop-shadow(0 0 calc(var(--glow) * 10px) currentColor); transition: opacity .2s, transform .2s; }
  .nx-blink { animation: nx-blink 1.8s ease-in-out infinite; }
  @keyframes nx-blink { 50% { opacity: 0.55; } }
  .nx-breathe { animation: nx-breathe 3s ease-in-out infinite; }
  @keyframes nx-breathe { 50% { transform: scale(1.08); } }
  .nx-ripple { fill: none; stroke: var(--accent); stroke-width: 1.2; animation: nx-ripple 2.7s ease-out infinite; }
  @keyframes nx-ripple { from { transform: scale(1); opacity: 0.7; } to { transform: scale(2.6); opacity: 0; } }
  .nx-hit { background: transparent; cursor: pointer; }
  .nx-hit:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nx-tip { display: none; }
  @media (min-width: 768px) { .nexus[data-focus]:not([data-focus="core"]) .nx-tip.is-on { display: block; } }
  /* focus mode: dim the other nodes, brighten the focused link */
  .nexus:not([data-focus="core"]) [data-node-g] { opacity: 0.3; transition: opacity .2s; }
  .nexus:not([data-focus="core"]) [data-node-g].is-on { opacity: 1; }
  .nexus:not([data-focus="core"]) .nx-link { stroke-opacity: 0.12; }
  .nexus:not([data-focus="core"]) .nx-link.is-on { stroke-opacity: 0.95; stroke-width: 2.4; }
</style>

<script>
  const root = document.getElementById("nexus");
  if (root) {
    const set = (id: string) => {
      root.dataset.focus = id;
      root.querySelectorAll<HTMLElement>("[data-core]").forEach((el) => (el.hidden = el.dataset.core !== id));
      root.querySelectorAll("[data-node-g]").forEach((el) => el.classList.toggle("is-on", el.getAttribute("data-node-g") === id));
      root.querySelectorAll("[data-link]").forEach((el) => el.classList.toggle("is-on", el.getAttribute("data-link") === id));
      root.querySelectorAll("[data-tip]").forEach((el) => el.classList.toggle("is-on", el.getAttribute("data-tip") === id));
    };
    root.querySelectorAll<HTMLButtonElement>("[data-node]").forEach((b) => {
      const id = b.dataset.node!;
      b.addEventListener("mouseenter", () => set(id));
      b.addEventListener("focus", () => set(id));
      b.addEventListener("click", () => set(id));
      b.addEventListener("mouseleave", () => { if (document.activeElement !== b) set("core"); });
      b.addEventListener("blur", () => set("core"));
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") { set("core"); (document.activeElement as HTMLElement | null)?.blur(); } });
  }
</script>
