---
// White-box explanation of a rule: each criterion, its source, the cut-off, and whether it was met.
import SourceBadge from "./SourceBadge.astro";
import { Check, Minus } from "@lucide/astro";
type Input = { label: string; value: string; unit?: string; src: number; met: boolean; rule: string };
interface Props { inputs: Input[]; result: string; rule?: string }
const { inputs, result, rule } = Astro.props;
---
<figure class="m-0">
  <ul class="space-y-2">
    {inputs.map((i) => (
      <li class="grid grid-cols-[auto_minmax(0,1fr)_auto_auto] items-center gap-2.5 text-sm">
        <SourceBadge no={i.src} />
        <span class="min-w-0"><span class:list={[i.met ? "text-ink" : "text-ink-3"]}>{i.label}</span> <span class="num text-ink-3">{i.value}{i.unit ? ` ${i.unit}` : ""}</span></span>
        <span class="text-xs text-ink-3 text-right">{i.rule}</span>
        <span class:list={["inline-flex h-5 w-5 items-center justify-center rounded-full", i.met ? "bg-warn-soft text-warn" : "bg-subtle text-ink-3"]}>
          {i.met ? <Check size={13} aria-label="เข้าเกณฑ์" /> : <Minus size={13} aria-label="ไม่เข้าเกณฑ์" />}
        </span>
      </li>
    ))}
  </ul>
  <figcaption class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line pt-3 text-sm">
    <span>ผล <strong class="num">{result}</strong></span>
    {rule && <span class="ml-auto text-xs text-ink-3">{rule}</span>}
  </figcaption>
</figure>
